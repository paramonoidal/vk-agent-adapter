{
  "id": "vk",
  "channels": [
    "vk"
  ],
  "doctorContract": {
    "stateMigrations": []
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "vk": {
      "label": "VK",
      "description": "VK (VKontakte) community bot via Long Poll API.",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "diagnostics": {
            "type": "object",
            "description": "Channel-wide diagnostics level. `openclaw config validate` reads this schema, so the level is typed here as well as in the zod schema.",
            "additionalProperties": false,
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "off",
                  "redacted",
                  "full"
                ]
              }
            }
          },
          "accounts": {
            "type": "object",
            "description": "Per-account overrides. The diagnostics level is channel-wide and is not accepted here.",
            "additionalProperties": {
              "type": "object",
              "not": {
                "required": [
                  "diagnostics"
                ]
              }
            }
          }
        }
      }
    }
  }
}
